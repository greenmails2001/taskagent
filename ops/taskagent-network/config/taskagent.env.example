# Canonical TaskAgent network contract. Copy outside the repository and edit there.
TASKAGENT_APP_ORIGIN=https://taskagent.example.com
TASKAGENT_API_ORIGIN=https://taskagent.example.com
TASKAGENT_FRONTEND_URL=http://192.0.2.10:7300
TASKAGENT_INTERNAL_BACKEND_URL=http://127.0.0.1:7301
TASKAGENT_OBSERVER_URL=http://127.0.0.1:7391
TASKAGENT_UPLOAD_DIR=/srv/taskagent/uploads
TASKAGENT_SERVICE_USER=localai
TASKAGENT_INGRESS_MODE=cloudflare_caddy
TASKAGENT_BACKUP_ROOT=/backup/taskagent
TASKAGENT_POSTGRES_CONTAINER=taskagent-postgres
TASKAGENT_DATABASE_NAME=taskagent
TASKAGENT_DATABASE_USER=taskagent
TASKAGENT_RESTORE_TEST_DATABASE=taskagent_restore_verify
CORS_ALLOWED_ORIGINS=https://taskagent.example.com
N9_NETWORK_PUBLIC_ALLOWED_CIDRS=192.0.2.0/24
N9_NETWORK_OBSERVER_PORT=7391
N9_NETWORK_INVENTORY=/opt/taskagent-network/observer/inventory.json
# Secrets and TaskAgent scope IDs belong in the deployed 0600 env file, not Git.
