[Unit]
Description=N9 TaskAgent native backend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/u01/apps/n9/sources/taskagent-source/server
EnvironmentFile=/u01/apps/n9/config/taskagent/backend.env
ExecStart=/u01/apps/n9/sources/taskagent-source/bin/taskagent-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
